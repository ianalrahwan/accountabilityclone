NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayPal (set MOCK_PAYPAL=true for local dev without credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REDIRECT_URI=http://localhost:3000/api/paypal/callback
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
MOCK_PAYPAL=true

# Encryption key for PayPal tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_SECRET=

# Secret for scheduler cron endpoint (generate with: node -e "console.log(require('crypto').randomUUID())")
SCHEDULER_SECRET=
